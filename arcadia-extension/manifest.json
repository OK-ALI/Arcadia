{
  "manifest_version": 3,
  "name": "Arcadia Download Interceptor",
  "version": "1.1",
  "description": "Intercepts standard file downloads and redirects them to the Arcadia Core client.",
  "permissions": [
    "downloads",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
